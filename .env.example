# ============================================================
# MLB Predictor — Python 機器人 / 排程腳本所需環境變數
# ============================================================
# 這個專案主要透過 GitHub Actions 排程執行（.github/workflows/），
# 所以「正式」金鑰是設定在 GitHub repo 的 Secrets，而不是這個檔案。
# 這個檔案只是給你本機測試時參考用（cp .env.example .env 後手動 export，
# 或用 `export $(grep -v '^#' .env | xargs)` 載入，腳本本身沒有讀 .env）。
#
# 設定位置：GitHub repo → Settings → Secrets and variables → Actions
#           → New repository secret
# ============================================================

# The Odds API（讀取讓分/大小分/獨贏賠率）— 必填
# 申請：https://the-odds-api.com/
ODDS_API_KEY=

# GitHub Personal Access Token — 必填
# 用途：讀寫 Gist（歷史戰績存放於 Gist，GIST_DESC="mlb_bot_history"）
#       以及部分 workflow 用它 checkout / push。
# 建立：GitHub → Settings → Developer settings → Personal access tokens
#       （fine-grained 或 classic 皆可，classic 需勾選 "gist" scope）
GH_TOKEN=

# Discord Webhook URL（推播每日預測結果到 Discord）— 選填
# 建立：Discord 頻道 → 設定 → 整合 → Webhook → 複製 URL
DISCORD_WEBHOOK=

# OpenWeatherMap API Key（比賽天氣調整用）— 選填
# 申請：https://openweathermap.org/api
WEATHER_API_KEY=

# ntfy.sh 推播主題名稱（即時比分推播）— 選填，未設會用預設值
NTFY_TOPIC=

# Supabase 專案設定 — 必填（用來把 picks_latest.json 上傳到 Storage，
# 以及寫入戰績戰績/戰績統計，供網站前端讀取）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
