# ============================================================
# MLB Predictor 網站（Next.js）環境變數
# ============================================================
# 本機開發：複製這個檔案為 .env.local，填入實際值
#   cp .env.example .env.local
# 正式部署（Vercel）：到 Vercel 專案 → Settings → Environment Variables
#   把下面每一個變數都加進去
# ============================================================

# Supabase 專案（前端可公開的值，在 Supabase Dashboard → Project Settings → API 取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key（後端專用，切勿加 NEXT_PUBLIC_ 前綴、切勿外流）
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Stripe（付費訂閱 / 單日券）
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → 建立 endpoint 後取得的 Signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard → Product catalog → 建立「月訂閱」「單日券」兩個 Price，複製 Price ID
STRIPE_MONTHLY_PRICE_ID=
STRIPE_DAYPASS_PRICE_ID=

# 網站正式網址（Stripe Checkout 完成後導回用），例如 https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# 網站擁有者/管理員信箱（選填，逗號分隔，例如 you@gmail.com,other@gmail.com）
# 用這個信箱登入的帳號永遠顯示已解鎖內容，不需要訂閱或付款
ADMIN_EMAILS=
