# ============================================================
# MLB Predictor 網站（Next.js）環境變數
# ============================================================
# 本機開發：複製這個檔案為 .env.local，填入實際值
#   cp .env.example .env.local
# 正式部署（Vercel）：到 Vercel 專案 → Settings → Environment Variables
#   把下面每一個變數都加進去
# ============================================================

# Supabase 專案（前端可公開的值，在 Supabase Dashboard → Project Settings → API 取得）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key（後端專用，切勿加 NEXT_PUBLIC_ 前綴、切勿外流）
# Supabase Dashboard → Project Settings → API → service_role secret
# 只用來從 Supabase Storage 讀取 picks_latest.json
SUPABASE_SERVICE_ROLE_KEY=

# 網站正式網址，例如 https://your-app.vercel.app（選填，目前沒有功能依賴它）
NEXT_PUBLIC_APP_URL=
